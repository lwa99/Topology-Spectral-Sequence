{
    "cSpell.words": [
        "decomp"
    ],
    "[latex]": {
        "editor.wordWrap": "on",
        "editor.wordWrapColumn": 100
    },
    "latex-workshop.kpsewhich.path": "D:/texlive/2026/bin/windows/kpsewhich.exe",
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (TeX Live 2026)",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "D:/texlive/2026/bin/windows/latexmk.exe",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "-auxdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ]
}
